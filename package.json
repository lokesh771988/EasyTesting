{
  "name": "cstesting",
  "version": "0.1.13",
  "description": "A simple, extensible Node.js testing framework — start with a test runner and assertions, extend with browser automation later.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cstesting": "dist/cli.js",
    "cst": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "node -e \"console.log('CSTesting installed. Run npm create cstesting@latest or npx cstesting init to scaffold tests.')\"",
    "test": "node dist/cli.js",
    "test:example": "node dist/cli.js example/",
    "example": "npm run build && npm run test:example",
    "verify:publish": "node scripts/verify-publish.js",
    "prepublishOnly": "npm run build && npm run verify:publish"
  },
  "keywords": [
    "testing",
    "test-runner",
    "assertions",
    "nodejs",
    "automation"
  ],
  "author": "Gorantla Lokesh",
  "license": "CS Technologies Telugu",
  "repository": {
    "type": "git",
    "url": "https://github.com/cstesttool/CSTesting-Nodejs"
  },
  "bugs": {
    "url": "https://github.com/cstesttool/CSTesting-Nodejs/issues"
  },
  "homepage": "https://cstesting.github.io/cstesting/",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "templates"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./init": {
      "types": "./dist/init-project.d.ts",
      "default": "./dist/init-project.js"
    }
  },
  "dependencies": {
    "chrome-launcher": "^1.0.0",
    "chrome-remote-interface": "^0.33.2"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
